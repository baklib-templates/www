{% schema %}
    {
        "name": "Index.WorthCargo",
        "description": "卓跃国际货运首页模板",
        "thumb_url": "images/theme/index.webp",
        "preview_image_urls": [
          "images/theme/index.webp"
        ],
        "sub_page_templates": ["channel"],
        "settings": [
          {"id": "hero_title","type": "html","placeholder": "","label": "首页标题", "default": "全球综合物流<br>一站式服务商"},
          {"id": "hero_description","type": "textarea","label": "首页描述", "default": "卓跃国际货运专注于中国至美国、加拿大、墨西哥等地的海运、空运、拼箱、铁路运输，提供全链路FBA清关、仓储、派送一站式服务。"},
          {"id": "hero_image_url","type": "image_picker","ratio": "16:9","width": 300, "label": "首页封面图（单张，兼容旧版本）"},
          {"id": "hero_images","type": "text","label": "Hero轮播图片（多张图片URL，用逗号分隔）", "placeholder": "https://example.com/image1.jpg,https://example.com/image2.jpg", "default": ""},
          {"id": "stat_years","type": "text","label": "统计-年限", "default": "16"},
          {"id": "stat_years_label","type": "html","label": "统计-年限标签", "default": "16年跨境物流品牌<br>6大分公司布局"},
          {"id": "stat_countries","type": "text","label": "统计-国家数", "default": "293"},
          {"id": "stat_countries_label","type": "html","label": "统计-国家数标签", "default": "业务遍布中东、欧美<br>上百个国家和地区"},
          {"id": "stat_channels","type": "text","label": "统计-渠道数", "default": "300"},
          {"id": "stat_channels_label","type": "html","label": "统计-渠道数标签", "default": "300多个渠道资源积累<br>涵盖航司、船司、物流"},
          {"id": "stat_warehouse","type": "text","label": "统计-仓储面积", "default": "30000"},
          {"id": "stat_warehouse_label","type": "html","label": "统计-仓储面积标签", "default": "5大自营海外仓<br>总仓储面积超过3万平米"},
