{% assign services_page = site.pages['/services'] %}
{% assign news_page = site.pages['/news'] %}
{% assign cases_page = site.pages['/cases'] %}
{% assign latest_articles = site.pages['/'].pages_in_list | order_by: '-created_at' | limit: 6 %}

{% query filtered_pages from page.pages_in_list %}
  {
    "where": {
      "template_name_eq": "page"
    },
    "order_by": ["-created_at asc"]
  }
{% endquery %}

<main id="content" class="relative -mt-24">
  <!-- =========={ Hero Section with Carousel }==========  -->
  {% comment %} 解析 Hero 图片列表 {% endcomment %}
  {% assign hero_images_str = page.settings.hero_images | default: '' | strip %}
  {% if hero_images_str == '' and page.settings.hero_image_url %}
    {% assign hero_images_str = page.settings.hero_image_url %}
  {% endif %}
  {% if hero_images_str == '' %}
    {% assign hero_images_str = 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1920&h=1080&fit=crop' %}
  {% endif %}
  {% assign hero_images = hero_images_str | split: ',' %}

  <section id="hero"
    x-data="{
      currentSlide: 0,
      slides: {{ hero_images.size }},
      autoplayInterval: null,
      init() {
        this.startAutoplay();
      },
      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.next();
        }, 5000); // 5秒自动切换
      },
      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      },
      next() {
        this.currentSlide = (this.currentSlide + 1) % this.slides;
      },
      prev() {
        this.currentSlide = (this.currentSlide - 1 + this.slides) % this.slides;
      },
      goToSlide(index) {
        this.currentSlide = index;
      }
    }"
    @mouseenter="stopAutoplay()"
    @mouseleave="startAutoplay()"
    class="relative h-[500px] md:h-[600px] lg:h-[700px] flex items-center overflow-hidden">

    {% comment %} 背景图片轮播 {% endcomment %}
    <div class="absolute inset-0 z-0">
      {% for image_url in hero_images %}
        {% assign clean_url = image_url | strip %}
        <div
          x-show="currentSlide === {{ forloop.index0 }}"
          x-transition:enter="transition ease-out duration-1000"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-1000"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
          class="absolute inset-0 bg-contain bg-center bg-no-repeat"
          style="background-image: url('{{ clean_url }}');">
          {% comment %} 深色遮罩层，确保文字可读性 {% endcomment %}
          <div class="absolute inset-0 bg-gradient-to-r from-gray-900/70 via-gray-900/50 to-transparent"></div>
        </div>
      {% endfor %}
    </div>

    {% comment %} 内容区域 {% endcomment %}
    <div class="container xl:max-w-7xl mx-auto px-4 relative z-10 w-full">
      <div class="flex flex-wrap -mx-4 items-center">
        <div class="w-full lg:w-1/2 px-4">
          <h1 class="text-2xl lg:text-3xl xl:text-4xl font-bold mb-6 leading-tight text-white drop-shadow-lg">
            {{ page.settings.hero_title | default: '深圳市卓跃国际物流有限公司<br>全球综合物流,一站式服务商' }}
          </h1>
          <p class="text-base text-gray-100 mb-8 leading-relaxed drop-shadow-md">
            {{ page.settings.hero_description | default: '卓跃国际货运专注于中国至美国、加拿大、墨西哥等地的海运、空运、拼箱、铁路运输，提供全链路FBA清关、仓储、派送一站式服务。' }}
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="{{ site.settings.request_url }}" class="px-8 py-3 bg-yellow-400 text-gray-900 font-semibold rounded-md hover:bg-yellow-500 transition-colors shadow-lg">
              {{ site.settings.request_title | default: '立即咨询' }}
            </a>
            <a href="/about" class="px-8 py-3 bg-transparent border-2 border-white text-white font-semibold rounded-md hover:bg-white hover:text-gray-900 transition-colors shadow-lg">
              了解更多
            </a>
          </div>
        </div>
      </div>
    </div>

    {% comment %} 左右箭头导航 {% endcomment %}
    {% if hero_images.size > 1 %}
      {% comment %} 左箭头 {% endcomment %}
      <button
        @click="prev(); stopAutoplay(); setTimeout(() => startAutoplay(), 3000);"
        class="absolute left-4 lg:left-8 top-1/2 -translate-y-1/2 z-20 bg-white/20 hover:bg-white/30 backdrop-blur-sm text-white p-3 rounded-full transition-all shadow-lg"
        aria-label="上一张">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      {% comment %} 右箭头 {% endcomment %}
      <button
        @click="next(); stopAutoplay(); setTimeout(() => startAutoplay(), 3000);"
        class="absolute right-4 lg:right-8 top-1/2 -translate-y-1/2 z-20 bg-white/20 hover:bg-white/30 backdrop-blur-sm text-white p-3 rounded-full transition-all shadow-lg"
        aria-label="下一张">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

      {% comment %} 指示器 {% endcomment %}
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex gap-2">
        {% for image_url in hero_images %}
          <button
            @click="goToSlide({{ forloop.index0 }}); stopAutoplay(); setTimeout(() => startAutoplay(), 3000);"
            :class="currentSlide === {{ forloop.index0 }} ? 'bg-white w-8' : 'bg-white/50 w-2'"
            class="h-2 rounded-full transition-all"
            aria-label="切换到第 {{ forloop.index }} 张">
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </section>

  <!-- =========={ Stats Section }==========  -->
  <section class="py-12 bg-white border-b border-gray-200">
    <div class="container xl:max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-primary-700 mb-2">{{ page.settings.stat_years | default: '16' }}</div>
          <div class="text-gray-600 text-sm lg:text-base">{{ page.settings.stat_years_label | default: '16年跨境物流品牌<br>6大分公司布局' }}</div>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-primary-700 mb-2">{{ page.settings.stat_countries | default: '293' }}</div>
          <div class="text-gray-600 text-sm lg:text-base">{{ page.settings.stat_countries_label | default: '业务遍布中东、欧美<br>上百个国家和地区' }}</div>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-primary-700 mb-2">{{ page.settings.stat_channels | default: '300' }}</div>
          <div class="text-gray-600 text-sm lg:text-base">{{ page.settings.stat_channels_label | default: '300多个渠道资源积累<br>涵盖航司、船司、物流' }}</div>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-bold text-primary-700 mb-2">{{ page.settings.stat_warehouse | default: '30000' }}</div>
          <div class="text-gray-600 text-sm lg:text-base">{{ page.settings.stat_warehouse_label | default: '5大自营海外仓<br>总仓储面积超过3万平米' }}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========={ Quick Services }==========  -->
  <section class="py-16 bg-gray-50">
    <div class="container xl:max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">货物跟踪</h3>
          <p class="text-gray-600 text-sm">快速准确反映当前货物的路由信息</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">船期查询</h3>
          <p class="text-gray-600 text-sm">点击获取最新最全的航线报价</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">会员登陆</h3>
          <p class="text-gray-600 text-sm">点击查看我们的联系方式</p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========={ Main Services }==========  -->
  <section class="py-16 bg-white">
    <div class="container xl:max-w-7xl mx-auto px-4">
      <header class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-800 mb-4">主营业务</h2>
        <p class="text-xl text-gray-600">跨境国际货运一站式服务品牌</p>
      </header>

      {% if services_page %}
        {% assign service_items = services_page.children_in_list | limit: 9 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {% for service in service_items %}
            <div class="bg-gray-50 p-6 rounded-lg hover:shadow-lg transition-shadow">
              <img src="{{ service.settings.thumb_image_url | default: site.settings.default_thumb_image_url }}" alt="{{ service.settings.title }}" class="w-full mb-4">
              <h3 class="text-xl font-semibold mb-3 text-gray-800">{{ service.settings.title }}</h3>
              <p class="text-gray-600 mb-4">{{ service.settings.description | truncate: 100 }}</p>
              <a href="{{ service.url }}" class="text-primary-700 hover:text-primary-800 font-medium">了解更多 →</a>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <!-- Default Services -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-gray-50 p-6 rounded-lg hover:shadow-lg transition-shadow">
            <h3 class="text-xl font-semibold mb-3 text-gray-800">国际海运</h3>
            <p class="text-gray-600 mb-4">海运承揽运送为本公司最大且最重要的营运项目，我们可向海内外客户提供整箱和拼箱货的运输服务。</p>
            <a href="/services" class="text-primary-700 hover:text-primary-800 font-medium">了解更多 →</a>
          </div>
          <div class="bg-gray-50 p-6 rounded-lg hover:shadow-lg transition-shadow">
            <h3 class="text-xl font-semibold mb-3 text-gray-800">国际空运</h3>
            <p class="text-gray-600 mb-4">我们的空运操作团队提供空进出口货物的国际运输代理业务、仓储、关务、报验业务、地面操作等一站式服务。</p>
            <a href="/services" class="text-primary-700 hover:text-primary-800 font-medium">了解更多 →</a>
          </div>
          <div class="bg-gray-50 p-6 rounded-lg hover:shadow-lg transition-shadow">
            <h3 class="text-xl font-semibold mb-3 text-gray-800">项目物流</h3>
            <p class="text-gray-600 mb-4">经济全球化的今天，您客户期待的是可靠、高效的服务。更快实现价值变得至关重要。</p>
            <a href="/services" class="text-primary-700 hover:text-primary-800 font-medium">了解更多 →</a>
          </div>
        </div>
      {% endif %}
    </div>
  </section>

  <!-- =========={ Service Features }==========  -->
  <section class="py-16 bg-gray-50">
    <div class="container xl:max-w-7xl mx-auto px-4">
      <header class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-800 mb-4">服务特色</h2>
        <p class="text-xl text-gray-600">跨境国际货运一站式服务品牌</p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-lg shadow-md text-center">
          <div class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">海运物流</h3>
          <p class="text-gray-600 text-sm">海运承揽运送为本公司最大且最重要的营运项目</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md text-center">
          <div class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">空运物流</h3>
          <p class="text-gray-600 text-sm">我们的空运操作团队提供空进出口货物的国际运输代理业务</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md text-center">
          <div class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">江海联运</h3>
          <p class="text-gray-600 text-sm">卓跃1,000+名专业人员为您提供量身定制的关务解决方案</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md text-center">
          <div class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">项目物流</h3>
          <p class="text-gray-600 text-sm">与经验丰富的4PL供应商合作，提高您的客户满意度</p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========={ News Carousel }==========  -->
  {% assign news_carousel_enabled = page.settings.news_carousel_enabled | default: true %}
  {% assign news_carousel_count = page.settings.news_carousel_count | default: 20 | plus: 0 %}
  {% if news_carousel_enabled %}
    <section class="py-16 bg-gray-50">
      <div class="container xl:max-w-7xl mx-auto px-4">
        {% comment %} 标签筛选器和轮播容器 {% endcomment %}
        <div
          x-data="{
            activeTab: 'all',
            swiperInstance: null,
            init() {
              // 等待 DOM 和 Swiper 加载完成
              const checkSwiper = () => {
                if (typeof Swiper !== 'undefined') {
                  this.initSwiper();
                } else {
                  setTimeout(checkSwiper, 100);
                }
              };
              checkSwiper();
            },
            initSwiper() {
              this.$nextTick(() => {
                const swiperEl = this.$el.querySelector('.news-swiper');
                const nextBtn = this.$el.querySelector('.news-swiper-button-next');
                const prevBtn = this.$el.querySelector('.news-swiper-button-prev');

                if (swiperEl && typeof Swiper !== 'undefined') {
                  if (this.swiperInstance) {
                    this.swiperInstance.destroy(true, true);
                  }
                  this.swiperInstance = new Swiper(swiperEl, {
                    slidesPerView: 1,
                    spaceBetween: 24,
                    loop: false,
                    grabCursor: true,
                    breakpoints: {
                      640: {
                        slidesPerView: 2,
                        spaceBetween: 20
                      },
                      768: {
                        slidesPerView: 2,
                        spaceBetween: 24
                      },
                      1024: {
                        slidesPerView: 3,
                        spaceBetween: 24
                      },
                      1280: {
                        slidesPerView: 4,
                        spaceBetween: 24
                      }
                    },
                    navigation: {
                      nextEl: nextBtn,
                      prevEl: prevBtn,
                    },
                  });
                }
              });
            },
            switchTab(tab) {
              this.activeTab = tab;
              // 标签切换时可以重新初始化轮播或筛选内容
              this.$nextTick(() => {
                if (this.swiperInstance) {
                  this.swiperInstance.update();
                }
              });
            }
          }"
          class="news-carousel-container">

          <div class="flex justify-center mb-8">
            <div class="flex gap-4 flex-wrap justify-center">
              <button
                @click="switchTab('all')"
                :class="activeTab === 'all' ? 'bg-primary-700 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'"
                class="px-6 py-2 rounded-full font-medium transition-colors">
                全部
              </button>
              <button
                @click="switchTab('company')"
                :class="activeTab === 'company' ? 'bg-primary-700 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'"
                class="px-6 py-2 rounded-full font-medium transition-colors">
                公司动态
              </button>
              <button
                @click="switchTab('industry')"
                :class="activeTab === 'industry' ? 'bg-primary-700 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'"
                class="px-6 py-2 rounded-full font-medium transition-colors">
                行业资讯
              </button>
              <button
                @click="switchTab('blog')"
                :class="activeTab === 'blog' ? 'bg-primary-700 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'"
                class="px-6 py-2 rounded-full font-medium transition-colors">
                公司博客
              </button>
            </div>
          </div>

          {% comment %} 文章轮播 {% endcomment %}
          {% assign all_articles = filtered_pages | limit: news_carousel_count %}
        <div class="relative">
          <div class="swiper news-swiper">
            <div class="swiper-wrapper">
              {% for article in all_articles %}
                {% assign article_date = article.published_at | date: '%Y-%m-%d' %}
                {% assign article_excerpt = article.setting.description | default: article.settings.content | strip_html | truncate: 80 %}
                {% assign article_image = article.settings.thumb_image_url | default: site.settings.default_thumb_image_url | default: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=800&h=600&fit=crop' %}

                <div class="swiper-slide">
                  <article class="bg-white rounded-lg shadow-md hover:shadow-xl transition-shadow overflow-hidden h-full flex flex-col">
                    {% comment %} 文章图片 {% endcomment %}
                    <div class="relative w-full h-48 overflow-hidden bg-gray-200">
                      <img
                        src="{{ article_image }}"
                        alt="{{ article.title }}"
                        class="w-full h-full object-cover">
                      {% comment %} 日期标签 {% endcomment %}
                      <div class="absolute bottom-0 right-0 bg-black/70 text-white px-3 py-1 text-sm font-medium">
                        {{ article_date }}
                      </div>
                    </div>

                    {% comment %} 文章内容 {% endcomment %}
                    <div class="p-6 flex-1 flex flex-col">
                      <h3 class="text-lg font-bold text-gray-800 mb-3 line-clamp-2 min-h-[3.5rem]">
                        <a href="{{ article.url }}" class="hover:text-primary-700 transition-colors">
                          {{ article.title }}
                        </a>
                      </h3>
                      <p class="text-gray-600 text-sm leading-relaxed mb-4 line-clamp-2 flex-1">
                        {{ article_excerpt }}
                      </p>
                      <a
                        href="{{ article.url }}"
                        class="text-primary-700 hover:text-primary-800 font-medium text-sm inline-flex items-center mt-auto">
                        阅读更多
                        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                      </a>
                    </div>
                  </article>
                </div>
              {% endfor %}
            </div>
          </div>

          {% comment %} 导航按钮 {% endcomment %}
          <button class="news-swiper-button-prev absolute left-0 top-1/2 -translate-y-1/2 z-10 bg-white shadow-lg rounded-full p-3 hover:bg-gray-50 transition-colors -translate-x-4 lg:-translate-x-12 hidden lg:flex items-center justify-center">
