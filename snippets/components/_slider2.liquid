{%# Slider 组件 style 2（来源：statics/snippets/slider.liquid） %}
<!-- Slider start -->
<div id="project" class="relative py-20 md:py-24 bg-white dark:bg-gray-800">
  <div class="container xl:max-w-6xl mx-auto px-4">
    <!-- section header -->
    <header class="text-center mx-auto mb-12 lg:px-20">
      <h2 class="text-2xl md:text-3xl leading-normal mb-2 font-semibold text-gray-800 dark:text-gray-100">Latest Project</h2>
      <hr class="block w-12 h-0.5 mx-auto my-5 bg-primary-700 border-primary-700">
      <p class="text-gray-500 leading-relaxed font-light text-xl mx-auto pb-2">Take a look at some of the iOS and Android apps we developed</p>
    </header><!-- end section header -->

    <div class="flex flex-wrap flex-row -mx-4 items-center">
      <div class="w-full lg:w-10/12 px-4 mx-auto">
        <!-- screenshot slider -->
        <div class="nav-dark-button" data-controller="swiper" data-swiper-options-value='{"loop":true,"autoHeight":true,"pagination":false,"navigation":true,"slidesPerView":"auto","spaceBetween":24}'>
          <div class="swiper">
            <div class="swiper-wrapper">
          <div class="swiper-slide max-w-full w-full md:w-1/2 lg:w-1/3 px-24 md:px-12 text-center">
            <div class="slider-item">
              <figure class="relative">
                <svg version="1.0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480.000000 906.000000">
                  <!-- Clip path image -->
                  <defs>
                    <clipPath id="svgf3">
                      <rect x="52" y="10" width="380" height="818"/>
                    </clipPath>
                  </defs>

                  <!-- Phone screen -->
                  <image clip-path="url(#svgf3)" xlink:href="../{{ 'images/img-min/app1.jpg' | asset_url }}" height="92%" width="100%" style="transform:translateY(30px);"></image>

                  <!-- Phone cover -->
                  <image xlink:href="../{{ 'images/img-min/iphone-dark.png' | asset_url }}" height="100%" width="100%"></image>
                </svg>
              </figure>
            </div>
          </div>
          <div class="swiper-slide max-w-full w-full md:w-1/2 lg:w-1/3 px-24 md:px-12 text-center">
