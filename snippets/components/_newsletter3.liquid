        <div class="p-6 md:p-12 rounded shadow lg:mx-16 bg-base-100">
          <div class="text-center mb-6">
            <h3 class="text-2xl leading-normal font-bold mb-0">Subcribe!</h3>
          </div>
          <!-- Form -->
          <form>
            <div class="mb-4">
