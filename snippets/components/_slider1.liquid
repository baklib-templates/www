{%# Slider 组件 style 1（来源：statics/snippets/slider.liquid） %}
<!-- Slider start -->
<div id="slider" class="relative bg-primary-900">
  <div class="slider-slider nav-inset-button nav-light-dots" data-controller="swiper" data-swiper-options-value='{"loop":true,"autoHeight":true,"autoplay":{"delay":5000,"disableOnInteraction":false},"pagination":{"clickable":true}}'>
          <div class="swiper">
            <div class="swiper-wrapper">
    <div class="swiper-slide w-full px-0 py-12 z-0" style="min-height: 520px;background-image: url({{ 'images/img-min/marketing.jpg' | asset_url }});background-size: cover;">

      <!-- background overlay -->
      <div class="absolute top-0 start-0 w-full h-full opacity-80 bg-black" style="z-index:-1;"></div>

      <div class="container xl:max-w-6xl mx-auto px-4">
        <div class="flex flex-wrap flex-row -mx-4 items-center justify-center">
          <!-- content -->
          <div class="max-w-full px-4 w-full md:w-10/12">
            <div class="mt-0 py-6 lg:py-12 text-center">
              <h1 class="text-3xl md:text-4xl leading-normal md:leading-normal font-semibold text-white mb-12">We Design and Develop Beautiful<br>Sites for your Business</h1>
              <a class="py-3 px-5 inline-block text-center rounded-md leading-normal text-gray-100 bg-primary-700 border border-primary-700 hover:text-white hover:bg-primary-800 hover:ring-0 hover:border-primary-800 focus:bg-primary-800 focus:border-primary-800 focus:outline-none focus:ring-0" href="#about">
                How We Work ?
              </a>
            </div>
          </div><!-- end content -->
        </div>
      </div>
    </div>

    <div class="swiper-slide w-full px-0 py-12 z-0" style="min-height: 520px;background-image: url({{ 'images/img-min/advertising.jpg' | asset_url }});background-size: cover;">
      <!-- background overlay -->
      <div class="absolute top-0 start-0 w-full h-full opacity-80 bg-black" style="z-index:-1;"></div>

      <div class="container xl:max-w-6xl mx-auto px-4">
        <div class="flex flex-wrap flex-row -mx-4 items-center justify-center">
          <!-- content -->
          <div class="max-w-full px-4 w-full md:w-10/12">
            <div class="mt-0 py-6 lg:py-12 text-center">
              <h2 class="text-3xl md:text-4xl leading-normal md:leading-normal font-semibold text-white mb-12">Developing a New Concept<br>With our Experience</h2>
              <a class="py-3 px-5 inline-block text-center rounded-md leading-normal text-gray-100 bg-primary-700 border border-primary-700 hover:text-white hover:bg-primary-800 hover:ring-0 hover:border-primary-800 focus:bg-primary-800 focus:border-primary-800 focus:outline-none focus:ring-0" href="#services">
                Our Services
              </a>
            </div>
          </div><!-- end content -->
        </div>
      </div>
    </div>
      </div>
            <div class="swiper-pagination"></div>
          </div>
        </div>
</div><!-- end slider-->
