{%# Portfolio 组件 style 3（来源：statics/snippets/portfolio.liquid） %}
<!-- =========={ PORTFOLIO }==========  -->
<div id="portfolio" class="relative py-20 md:py-24 bg-gray-100 dark:bg-gray-800">
  <div class="container xl:max-w-6xl mx-auto px-4">
    <!-- section header -->
    <header class="text-center mx-auto mb-12">
      <h2 class="text-2xl md:text-3xl leading-normal mb-2 font-bold text-gray-800 dark:text-gray-100"><span class="font-light">Our</span> Portfolio</h2>
      <hr class="block w-12 h-0.5 mx-auto my-5 bg-primary-700 border-primary-700">
    </header><!-- end section header -->

    <!-- slider -->
    <div class="lightgallery-slider mb-20 lg:mb-4 nav-dark-button nav-outset-button" data-controller="swiper" data-swiper-options-value='{"loop":true,"autoHeight":true,"allowTouchMove":false,"pagination":false,"navigation":true,"slidesPerView":"auto","spaceBetween":24}'>
          <div class="swiper">
            <div class="swiper-wrapper">
      <!-- item -->
      <div class="swiper-slide slider-item max-w-full w-full md:w-1/2 lg:w-1/3 px-4 cursor-pointer" data-src="{{ 'images/img/web/project1.jpg' | asset_url }}" data-sub-html="Screenshot 2">
        <div class="relative">
          <div class="h-72 relative"> 
            <div class="absolute inset-0 bg-top hover:bg-bottom" style='background-image: url("{{ 'images/img/web/project1.jpg' | asset_url }}");background-repeat: no-repeat;transition: 2s;background-size: 100%;'>
              <img class="hidden" src="{{ 'images/img/web/project1.jpg' | asset_url }}">
            </div> 
          </div> 
          <div class="relative bg-white dark:bg-gray-900">
            <div class="p-4">
              <p class="text-sm text-gray-500 mb-1.5">App</p> 
              <h3 class="text-xl font-bold mb-1.5">Project Name</h3> 
              <p class="text-lg">Website of the Business Center</p>
            </div>

            <div class="relative p-4"> 
              <button class="inline-block py-2 px-6 bg-white text-black font-semibold uppercase border-2 border-black hover:bg-black hover:text-white mb-3">Look</button>
            </div>
          </div>
        </div>
      </div>

      <!-- item -->
