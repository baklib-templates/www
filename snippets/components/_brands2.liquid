{%# Brands 组件 style 2：Swiper 轮播 Logo（无导航按钮，6 个）（来源：statics/snippets/brands.liquid） %}
<!-- start brands -->
<div id="partner-brand" class="relative py-16 bg-gray-50 dark:bg-gray-900 dark:bg-opacity-20">
  <div class="container xl:max-w-6xl mx-auto px-4">
    <div class="lex flex-wrap flex-row -mx-4 justify-center">
      <div class="w-full px-4">
        <!-- slider brand -->
        <div data-controller="swiper" data-swiper-options-value='{"loop":true,"autoHeight":true,"pagination":false,"slidesPerView":"auto","spaceBetween":24}'>
          <div class="swiper">
            <div class="swiper-wrapper">
              <div class="swiper-slide flex-shrink max-w-full w-full sm:w-1/2 md:w-1/3 lg:w-1/4 py-4 lg:py-1 px-6 lg:px-12 text-center">
                <a href="#" target="_blank">
                  <img class="brands-image mx-auto opacity-80 hover:opacity-100 max-w-full h-auto" src="{{ 'images/img-min/img1.png' | asset_url }}" alt="Image Description">
                </a>
              </div>
              <div class="swiper-slide flex-shrink max-w-full w-full sm:w-1/2 md:w-1/3 lg:w-1/4 py-4 lg:py-1 px-6 lg:px-12 text-center">
                <a href="#" target="_blank">
                  <img class="brands-image mx-auto opacity-80 hover:opacity-100 max-w-full h-auto" src="{{ 'images/img-min/img2.png' | asset_url }}" alt="Image Description">
                </a>
              </div>
              <div class="swiper-slide flex-shrink max-w-full w-full sm:w-1/2 md:w-1/3 lg:w-1/4 py-4 lg:py-1 px-6 lg:px-12 text-center">
                <a href="#" target="_blank">
                  <img class="brands-image mx-auto opacity-80 hover:opacity-100 max-w-full h-auto" src="{{ 'images/img-min/img3.png' | asset_url }}" alt="Image Description">
                </a>
              </div>
              <div class="swiper-slide flex-shrink max-w-full w-full sm:w-1/2 md:w-1/3 lg:w-1/4 py-4 lg:py-1 px-6 lg:px-12 text-center">
                <a href="#" target="_blank">
                  <img class="brands-image mx-auto opacity-80 hover:opacity-100 max-w-full h-auto" src="{{ 'images/img-min/img4.png' | asset_url }}" alt="Image Description">
                </a>
              </div>
              <div class="swiper-slide flex-shrink max-w-full w-full sm:w-1/2 md:w-1/3 lg:w-1/4 py-4 lg:py-1 px-6 lg:px-12 text-center">
                <a href="#" target="_blank">
                  <img class="brands-image mx-auto opacity-80 hover:opacity-100 max-w-full h-auto" src="{{ 'images/img-min/img5.png' | asset_url }}" alt="Image Description">
                </a>
              </div>
              <div class="swiper-slide flex-shrink max-w-full w-full sm:w-1/2 md:w-1/3 lg:w-1/4 py-4 lg:py-1 px-6 lg:px-12 text-center">
                <a href="#" target="_blank">
                  <img class="brands-image mx-auto opacity-80 hover:opacity-100 max-w-full h-auto" src="{{ 'images/img-min/img6.png' | asset_url }}" alt="Image Description">
                </a>
              </div>
            </div>
          </div>
        </div><!-- end slider brand -->
      </div>
    </div>
  </div>
</div><!-- End brand-->
