{%# Content 组件 style 2（来源：statics/snippets/content.liquid） %}
<!-- content start -->
<div id="about" class="relative z-0 py-20 lg:py-24 bg-base-100">
  <!-- bg wrapper -->
  <div class="absolute inset-y-0 start-auto end-0 hidden lg:block w-1/3 bg-base-200" style="z-index:-1"></div>
  <div class="container xl:max-w-6xl mx-auto px-4">
    <div class="flex flex-wrap flex-row">
      <!-- img block -->
      <div class="flex-shrink max-w-full px-4 w-full lg:w-1/2 lg:order-2">
        <img src="{{ 'images/img-min/creative-content.svg' | asset_url }}" class="w-full max-w-full h-auto" alt="creative agency">
      </div>

      <!-- content block -->
      <div class="flex-shrink max-w-full px-4 w-full lg:w-1/2 lg:order-1 my-auto">
        <div class="p-4 md:p-12 lg:p-16 lg:ps-0 text-center lg:text-start">
          <h2 class="text-4xl leading-normal mb-4 font-semibold text-base-content">Build your Awesome <span class="text-primary">Website and Logo Design</span></h2>
          <p class="text-base-content/70 leading-relaxed font-light text-xl mx-auto pb-2">Landcore is a full service Creative Agency in New York, providing integrated solutions for your business. We offer services from Logo design, web & mobile apps design, photography, event organizer and etc.</p>
        </div>
      </div>
    </div>
  </div>
</div><!-- end content -->
