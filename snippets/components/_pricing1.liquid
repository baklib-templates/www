{%# Pricing 组件 style 1（来源：statics/snippets/pricing.liquid） %}
<!-- Pricing start -->
<div id="pricing" class="relative pt-20 pb-8 md:pt-24 md:pb-12 bg-base-200">
  <div x-data="{ open: false }" class="container xl:max-w-6xl mx-auto px-4">
    <!-- section header -->
    <header class="text-center mx-auto mb-12">
      <h2 class="text-2xl md:text-3xl leading-normal mb-2 font-bold text-base-content"><span class="font-light">Our</span> Pricing</h2>
      <hr class="block w-12 h-0.5 mx-auto my-5 bg-primary border-primary">
      <p class="text-base-content/70 leading-relaxed font-light text-xl mx-auto pb-2">Pay only fixed monthly fee and the rest we will handle for you!</p>
    </header><!-- end section header -->

    <!-- navigation -->
    <div class="text-center mb-12 lg:mb-24">
      <div class="flex justify-center mb-12 lg:mb-16">
        <label class="flex items-center cursor-pointer justify-between mb-5">
          <span>Monthly</span>
          <input type="checkbox" id="js-checkbox" class="hidden">
          <i @click="open = !open" aria-expanded="false" x-bind:aria-expanded="open.toString()" class="relative inline-block w-24 h-7 border border-base-300 rounded-xl transition mx-4">
            <span :class="{ 'hidden': open, 'block': !(open) }" x-description="off" x-state:on="on" x-state:off="off" class="absolute start-0 w-10 h-6 rounded-xl bg-primary" ></span>
            <span :class="{ 'block': open, 'hidden': !(open) }" x-description="on" x-state:on="on" x-state:off="off" class="absolute end-0 w-10 h-6 rounded-xl bg-primary"></span>
          </i>
          <span>Yearly</span>
        </label>
      </div>
    </div>

    <!-- row -->
    <div class="flex flex-wrap flex-row -mx-4 justify-center">
      <div class="flex-shrink max-w-full w-11/12 md:w-1/2 lg:w-1/3 px-4">
        <div class="xl:px-2">
          <!-- price table-->
          <div class="relative bg-base-100 shadow-xl border border-base-300 rounded-xl mb-12 wow fadeInLeft" data-wow-duration="1s">
            <!-- pricing header -->
            <header class="relative pt-12 px-16 pb-4">
              <h3 class="text-2xl leading-normal mb-2 font-semibold text-base-content">Starter</h3>
              <p class="text-base-content/70">Start Up</p>
              <div class="h-1 w-full bg-primary mt-2 mb-5"></div>
              <div>
                <h4 :class="{ 'hidden': open, 'block': !(open) }" x-description="off" x-state:on="on" x-state:off="off" class="text-2xl leading-normal mb-2 font-semibold text-primary">$19.99 <span class="small fw-light">/Month</span></h4>
                <h4 :class="{ 'block': open, 'hidden': !(open) }" x-description="on" x-state:on="on" x-state:off="off" class="text-2xl leading-normal mb-2 font-semibold text-primary">$199.99 <span class="small fw-light">/Year</span></h4>
              </div>
            </header><!-- end pricing header -->

            <!-- pricing content -->
            <div class="relative px-16 pb-12 text-base-content/70">
              <div class="mb-8">
                <p class="mb-4">100 Employee</p>
                <p class="mb-4">Unlimited Features</p>
                <p class="mb-4">Presentation Software</p>
                <p class="mb-4">Project Management</p>
                <p class="mb-4">Event Management</p>
              </div>
              <a class="py-3 px-5 block text-center rounded-md leading-normal text-neutral-content bg-neutral border border-base-300 hover:text-neutral-content hover:bg-neutral hover:ring-0 hover:border-black focus:bg-neutral focus:border-black focus:outline-none focus:ring-0" href="#">Get Started</a>
            </div><!-- end pricing content -->
          </div><!-- End price table-->
        </div>
      </div>

      <div class="flex-shrink max-w-full w-11/12 md:w-1/2 lg:w-1/3 px-4">
        <div class="xl:px-2">
          <!-- price table-->
          <div class="relative bg-base-100 shadow-xl border border-base-300 rounded-xl lg:-mt-8 mb-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay=".1s">
            <!-- ribbon -->
            <div class="absolute top-0 end-0 text-end w-36 h-36 text-sm">
              <span class="absolute top-4 end-0 px-4 py-2 block align-center shadow bg-warning text-base-content">Popular</span>
            </div>
            <!-- pricing header -->
            <div class="relative pt-12 px-16 pb-4">
              <h3 class="text-2xl leading-normal mb-2 font-semibold text-base-content">Professional</h3>
              <p class="text-base-content/70">Small Business</p>
              <div class="h-1 w-full bg-primary mt-2 mb-5"></div>
              <div>
                <h4 :class="{ 'hidden': open, 'block': !(open) }" x-description="off" x-state:on="on" x-state:off="off" class="text-2xl leading-normal mb-2 font-semibold text-primary">$29.99 <span class="small fw-light">/Month</span></h4>
                <h4 :class="{ 'block': open, 'hidden': !(open) }" x-description="on" x-state:on="on" x-state:off="off" class="text-2xl leading-normal mb-2 font-semibold text-primary">$299.99 <span class="small fw-light">/Year</span></h4>
              </div>
            </div><!-- end pricing header -->

            <!-- pricing content -->
            <div class="relative px-16 pb-12 text-base-content/70">
              <div class="mb-8">
                <p class="mb-4">500 Employee</p>
                <p class="mb-4">Unlimited Features</p>
                <p class="mb-4">Presentation Software</p>
                <p class="mb-4">Project Management</p>
                <p class="mb-4">Event Management</p>
                <p class="mb-4">Most Popular</p>
              </div>
              <a class="py-3 px-5 block text-center rounded-md leading-normal text-primary-content bg-primary border border-primary hover:text-primary-content hover:bg-primary hover:ring-0 hover:border-primary focus:bg-primary focus:border-primary focus:outline-none focus:ring-0" href="#">
                <svg xmlns="http://www.w3.org/2000/svg" class="me-2 transform ltr:rotate-0 rtl:-rotate-90 inline-block" width="1.5rem" height="1.5rem" viewBox="0 0 512 512"><path d="M53.12,199.94l400-151.39a8,8,0,0,1,10.33,10.33l-151.39,400a8,8,0,0,1-15-.34L229.66,292.45a16,16,0,0,0-10.11-10.11L53.46,215A8,8,0,0,1,53.12,199.94Z" style="fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:32px"></path><line x1="460" y1="52" x2="227" y2="285" style="fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:32px"></line></svg>Get Started
              </a>
            </div><!-- end pricing content -->
          </div><!-- end pricing table -->
        </div>
      </div>

      <div class="flex-shrink max-w-full w-11/12 md:w-1/2 lg:w-1/3 px-4">
        <div class="xl:px-2">
          <!-- price table-->
          <div class="relative bg-base-100 shadow-xl border border-base-300 rounded-xl mb-12 wow fadeInRight" data-wow-duration="1s">
            <!-- pricing header -->
            <header class="relative pt-12 px-16 pb-4">
              <h3 class="text-2xl leading-normal mb-2 font-semibold text-base-content">Expert</h3>
              <p class="text-base-content/70">Big Business</p>
              <div class="h-1 w-full bg-primary mt-2 mb-5"></div>
              <div>
                <h4 :class="{ 'hidden': open, 'block': !(open) }" x-description="off" x-state:on="on" x-state:off="off" class="text-2xl leading-normal mb-2 font-semibold text-primary">$39.99 <span class="small fw-light">/Month</span></h4>
                <h4 :class="{ 'block': open, 'hidden': !(open) }" x-description="on" x-state:on="on" x-state:off="off" class="text-2xl leading-normal mb-2 font-semibold text-primary">$399.99 <span class="small fw-light">/Year</span></h4>
              </div>
            </header><!-- end pricing header -->

            <!-- pricing content -->
            <div class="relative px-16 pb-12 text-base-content/70">
              <div class="mb-8">
                <p class="mb-4">1000 Employee</p>
                <p class="mb-4">Unlimited Features</p>
                <p class="mb-4">Presentation Software</p>
                <p class="mb-4">Project Management</p>
                <p class="mb-4">Event Management</p>
              </div>
              <a class="py-3 px-5 block text-center rounded-md leading-normal text-neutral-content bg-neutral border border-base-300 hover:text-neutral-content hover:bg-neutral hover:ring-0 hover:border-black focus:bg-neutral focus:border-black focus:outline-none focus:ring-0" href="#">Get Started</a>
            </div><!-- end pricing content -->
          </div><!-- End price table-->
        </div>
      </div>
    </div><!-- end row -->
  </div>
</div><!-- End Pricing -->
