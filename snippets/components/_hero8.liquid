        <div class="relative md:-mt-2 mb-16" style="padding-bottom: 120%">
          <!-- Android potrait -->
          <figure class="absolute start-0 top-0 w-3/4">
            <svg version="1.0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480.000000 906.000000">
              <!-- Clip path image -->
              <defs>
                <clipPath id="svgf">
                  <rect x="50" y="16.5" width="480" height="1066"/>
                </clipPath>
              </defs>
              <!-- Phone screen -->
              <image clip-path="url(#svgf)" xlink:href="../{{ 'images/img-min/app1-android.jpg' | asset_url }}" height="94%" width="100%" style="transform:translateY(15px);"></image>
              <!-- Phone cover -->
              <image xlink:href="{{ 'images/img-min/android-dark.png' | asset_url }}"height="100%" width="100%"></image>
            </svg>
          </figure>

          <figure class="absolute end-0 w-3/4" style="top:12%">
            <svg version="1.0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480.000000 906.000000">
              <!-- Clip path image -->
              <defs>
                <clipPath id="svgf1">
                  <rect x="52" y="10" width="380" height="818"/>
                </clipPath>
              </defs>
              <!-- Phone screen -->
              <image clip-path="url(#svgf1)" xlink:href="../{{ 'images/img-min/app1.jpg' | asset_url }}" height="92%" width="100%" style="transform:translateY(30px);"></image>
              <!-- Phone cover -->
