{%# Services 组件 style 4（来源：statics/snippets/services.liquid） %}
<!-- Services start -->
<div id="services" class="relative pt-20 pb-8 md:pt-24 md:pb-12 bg-base-100">
  <div class="container xl:max-w-6xl mx-auto px-4">
    <!-- section header -->
    <header class="text-center mx-auto mb-12 lg:px-20">
      <h2 class="text-2xl md:text-3xl leading-normal mb-2 font-bold text-base-content"><span class="font-light">Our</span> Services</h2>
      <hr class="block w-12 h-0.5 mx-auto my-5 bg-primary border-primary">
      <p class="text-base-content/70 leading-relaxed font-light text-xl mx-auto pb-2">We help the companies build market through design and creativity. We are a creative serving local and international business ranging from Small to big companies all from various industries.</p>
    </header><!-- end section header -->

    <!-- row -->
    <div class="flex flex-wrap flex-row -mx-4">
      <div class="max-w-full px-4 w-full sm:w-1/2 lg:w-1/4">
        <!-- service block -->
        <div class="py-5 px-6 border rounded bg-base-200 mb-12 wow fadeInUp" data-wow-duration="1s">
          <h3 class="text-lg leading-normal mb-2 font-semibold text-primary-content opacity-80 capitalize">Design Identity</h3>
          <ul class="text-base-content/70">
            <li class="py-2 list-disc list-inside">Logo Design</li>
            <li class="py-2 list-disc list-inside">Visual Guideline</li>
            <li class="py-2 list-disc list-inside">Brand Identity</li>
            <li class="py-2 list-disc list-inside">Brand Applications</li>
            <li class="py-2 list-disc list-inside">Visual Identity</li>
          </ul>
        </div><!-- end service block -->
      </div>

      <div class="max-w-full px-4 w-full sm:w-1/2 lg:w-1/4">
        <!-- service block -->
        <div class="py-5 px-6 border rounded bg-base-200 mb-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay=".1s">
          <h3 class="text-lg leading-normal mb-2 font-semibold text-primary-content opacity-80 capitalize">Printed</h3>
          <ul class="text-base-content/70">
            <li class="py-2 list-disc list-inside">Marketing Collateral</li>
            <li class="py-2 list-disc list-inside">Packaging Design</li>
            <li class="py-2 list-disc list-inside">Profile Card</li>
            <li class="py-2 list-disc list-inside">Calendar Design</li>
            <li class="py-2 list-disc list-inside">Annual Report</li>
          </ul>
        </div><!-- end service block -->
      </div>

      <div class="max-w-full px-4 w-full sm:w-1/2 lg:w-1/4">
        <!-- service block -->
        <div class="py-5 px-6 border rounded bg-base-200 mb-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay=".3s">
          <h3 class="text-lg leading-normal mb-2 font-semibold text-primary-content opacity-80 capitalize">Digital Design</h3>
          <ul class="text-base-content/70">
            <li class="py-2 list-disc list-inside">Web Development</li>
            <li class="py-2 list-disc list-inside">UI/UX Design</li>
            <li class="py-2 list-disc list-inside">Videography</li>
            <li class="py-2 list-disc list-inside">Banner Ads Design</li>
            <li class="py-2 list-disc list-inside">Photography</li>
          </ul>
        </div><!-- end service block -->
      </div>

      <div class="max-w-full px-4 w-full sm:w-1/2 lg:w-1/4">
        <!-- service block -->
        <div class="py-5 px-6 border rounded bg-base-200 mb-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay=".5s">
          <h3 class="text-lg leading-normal mb-2 font-semibold text-primary-content opacity-80 capitalize">Subscriptions</h3>
          <ul class="text-base-content/70">
            <li class="py-2 list-disc list-inside">Unlimited Design</li>
            <li class="py-2 list-disc list-inside">Unlimited Revisions</li>
            <li class="py-2 list-disc list-inside">Dedicated Designer</li>
            <li class="py-2 list-disc list-inside">One Flat Monthly Fee</li>
            <li class="py-2 list-disc list-inside">Free Stock Photos</li>
          </ul>
        </div><!-- end service block -->
      </div>
    </div><!-- end row -->
  </div>
</div><!-- end section -->
