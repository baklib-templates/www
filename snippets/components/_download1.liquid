              <image clip-path="url(#svgf1)" xlink:href="../{{ 'images/img-min/app1.jpg' | asset_url }}" height="92%" width="100%" style="transform:translateY(30px);"></image>
              <!-- Phone cover -->
              <image xlink:href="../{{ 'images/img-min/iphone-dark.png' | asset_url }}" height="100%" width="100%"></image>
            </svg>
          </figure>
        </div>
      </div>

